{
  "name": "webmusicapremium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild worker.js --bundle --platform=node --target=node22 --format=cjs --outfile=.worker/worker.cjs --external:pg-native --log-level=warning",
    "start": "next start",
    "worker": "node .worker/worker.cjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:dev": "pglite-server --db=./.pglite-dev --port=55432 --max-connections=20",
    "db:verify-cutover": "node scripts/verify-cutover.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.9",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "vitest": "^5.0.0"
  },
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}

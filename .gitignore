# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# infraestructura: vars.sh lleva la clave pública SSH y el nombre del repo
deploy/bootstrap/vars.sh

# credenciales del servidor: nunca al repositorio
contabo.txt
*.key
*-backup.key
members_data.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worker empaquetado (npm run build:worker)
/.worker

# base local de desarrollo (npm run db:dev)
/.pglite-dev

# locales: no se publican (el repo es público)
.claude/settings.local.json
*.mp4
